{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afef:schema:v0.2:project-manifest",
  "title": "AFEF v0.2 Project Manifest",
  "description": "Exactly one adopter-owned YAML manifest exists at <project-root>/.afef/project-manifest.yaml; no alternate or configurable location is accepted. It records project identity, immutable AFEF pin, constitution, required record directories, and safety policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "repository",
    "afef",
    "constitution",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Stable repository URL or host-qualified owner/name identity."
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "afef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable AFEF version pin."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$",
          "description": "Immutable full AFEF commit pin."
        }
      }
    },
    "constitution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inline"
          ],
          "properties": {
            "inline": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specifications",
        "work_records"
      ],
      "properties": {
        "documentation": {
          "$ref": "#/$defs/repositoryPath"
        },
        "source": {
          "$ref": "#/$defs/repositoryPath"
        },
        "tests": {
          "$ref": "#/$defs/repositoryPath"
        },
        "architecture": {
          "$ref": "#/$defs/repositoryPath"
        },
        "decisions": {
          "$ref": "#/$defs/repositoryPath"
        },
        "specifications": {
          "$ref": "#/$defs/recordDirectory"
        },
        "work_records": {
          "$ref": "#/$defs/recordDirectory"
        },
        "evidence": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "default_risk_profile": {
      "enum": [
        "lean",
        "standard",
        "high_assurance"
      ]
    },
    "safety_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_owner": {
          "$ref": "#/$defs/actor"
        },
        "specification_approver": {
          "$ref": "#/$defs/actor"
        },
        "final_gate_owner": {
          "$ref": "#/$defs/finalGateActor"
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable opaque project identity. Display names are not identity."
        },
        "role": {
          "enum": [
            "product_owner",
            "design_supervisor",
            "implementation_supervisor",
            "ide_agent",
            "independent_reviewer"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional non-normative label that must not determine role separation."
        }
      }
    },
    "finalGateActor": {
      "allOf": [
        {
          "$ref": "#/$defs/actor"
        },
        {
          "not": {
            "properties": {
              "role": {
                "const": "ide_agent"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!~(?:/|$))(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*//)[^/\\\\]+(?:/[^/\\\\]+)*$",
      "description": "Deterministic repository-style path relative to the adopting project root; absolute, drive-qualified, home-relative, backslash, empty-segment, and dot-traversal forms are prohibited."
    },
    "recordDirectory": {
      "allOf": [
        {
          "$ref": "#/$defs/repositoryPath"
        }
      ],
      "description": "Required repository-relative directory whose direct files contain records; discovery is non-recursive."
    }
  }
}
