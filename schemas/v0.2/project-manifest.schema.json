{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afef:schema:v0.2:project-manifest",
  "title": "AFEF v0.2 Project Manifest",
  "description": "Adopter-owned project identity, immutable AFEF pin, constitution, paths, and safety policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "repository",
    "afef",
    "constitution"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Stable repository URL or host-qualified owner/name identity."
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "afef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable AFEF version pin."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$",
          "description": "Immutable full AFEF commit pin."
        }
      }
    },
    "constitution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inline"
          ],
          "properties": {
            "inline": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentation": {
          "$ref": "#/$defs/repositoryPath"
        },
        "source": {
          "$ref": "#/$defs/repositoryPath"
        },
        "tests": {
          "$ref": "#/$defs/repositoryPath"
        },
        "architecture": {
          "$ref": "#/$defs/repositoryPath"
        },
        "decisions": {
          "$ref": "#/$defs/repositoryPath"
        },
        "specifications": {
          "$ref": "#/$defs/repositoryPath"
        },
        "work_records": {
          "$ref": "#/$defs/repositoryPath"
        },
        "evidence": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "default_risk_profile": {
      "enum": [
        "lean",
        "standard",
        "high_assurance"
      ]
    },
    "safety_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_owner": {
          "type": "string",
          "minLength": 1
        },
        "specification_approver": {
          "type": "string",
          "minLength": 1
        },
        "final_gate_owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+",
      "description": "Path relative to the adopting repository root."
    }
  }
}
