{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afef:schema:v0.2:work-record",
  "title": "AFEF v0.2 Work Record",
  "description": "Adopter-owned bounded authorization, implementation state, evidence, review, and gate record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "related_specifications",
    "risk_profile",
    "scope",
    "authorization_envelope",
    "implementation_state",
    "reviews",
    "final_gate",
    "human_checkpoint"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "related_specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/specificationId"
      },
      "uniqueItems": true
    },
    "risk_profile": {
      "enum": [
        "lean",
        "standard",
        "high_assurance"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "out_of_scope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "authorization_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          },
          "description": "Normative operation decisions. Operation IDs must be unique within the work record; I2 enforces key uniqueness and decision consistency."
        },
        "authorization_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationAuthorization"
          },
          "description": "Separate authorization or evidence references bound to exact operation IDs. Authorization IDs must be unique within the work record."
        },
        "affected_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          },
          "uniqueItems": true
        },
        "constraints": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operations": {
                "contains": {
                  "$ref": "#/$defs/permittedSeparateReferenceOperation"
                }
              }
            },
            "required": [
              "operations"
            ]
          },
          "then": {
            "required": [
              "authorization_references"
            ],
            "properties": {
              "authorization_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "deliverables": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "implementation_state": {
      "enum": [
        "not_started",
        "in_progress",
        "implemented",
        "verified",
        "deferred"
      ]
    },
    "implementer": {
      "$ref": "#/$defs/actor"
    },
    "repository_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "working_tree": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1
    },
    "validation_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "description": "Zero or more review records. An empty array means no review has been requested or completed."
    },
    "independent_review": {
      "$ref": "#/$defs/independentReview"
    },
    "final_gate": {
      "$ref": "#/$defs/finalGate"
    },
    "human_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "next_required_action"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_reached",
            "awaiting",
            "completed"
          ]
        },
        "owner": {
          "$ref": "#/$defs/actor"
        },
        "next_required_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "known_limitations": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "implementation_state": {
            "enum": [
              "in_progress",
              "implemented",
              "verified"
            ]
          }
        },
        "required": [
          "implementation_state"
        ]
      },
      "then": {
        "required": [
          "implementer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk_profile": {
            "const": "high_assurance"
          }
        },
        "required": [
          "risk_profile"
        ]
      },
      "then": {
        "required": [
          "independent_review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk_profile": {
            "const": "high_assurance"
          },
          "final_gate": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "accepted_with_conditions"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "risk_profile",
          "final_gate"
        ]
      },
      "then": {
        "required": [
          "independent_review"
        ],
        "properties": {
          "independent_review": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "specificationId": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!~(?:/|$))(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*//)[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable opaque project identity. Display names are not identity."
        },
        "role": {
          "enum": [
            "product_owner",
            "design_supervisor",
            "implementation_supervisor",
            "ide_agent",
            "independent_reviewer"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional non-normative label that must not determine role separation."
        }
      }
    },
    "independentReviewer": {
      "allOf": [
        {
          "$ref": "#/$defs/actor"
        },
        {
          "properties": {
            "role": {
              "const": "independent_reviewer"
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "effect_class",
        "decision",
        "authorization_requirement"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^OP-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "effect_class": {
          "enum": [
            "local-read",
            "local-reversible-write",
            "local-destructive",
            "external-read",
            "external-write",
            "external-destructive",
            "identity-permission-change",
            "publication-release"
          ]
        },
        "decision": {
          "enum": [
            "permitted",
            "prohibited"
          ]
        },
        "authorization_requirement": {
          "enum": [
            "bounded_work_envelope",
            "separate_reference",
            "not_applicable"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Optional non-normative explanation; it does not grant or prohibit authority."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "prohibited"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "authorization_requirement": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/permittedProtectedOperation"
          },
          "then": {
            "properties": {
              "authorization_requirement": {
                "const": "separate_reference"
              }
            }
          }
        }
      ]
    },
    "permittedProtectedOperation": {
      "type": "object",
      "properties": {
        "effect_class": {
          "enum": [
            "local-destructive",
            "external-write",
            "external-destructive",
            "identity-permission-change",
            "publication-release"
          ]
        },
        "decision": {
          "const": "permitted"
        }
      },
      "required": [
        "effect_class",
        "decision"
      ]
    },
    "permittedSeparateReferenceOperation": {
      "type": "object",
      "properties": {
        "decision": {
          "const": "permitted"
        },
        "authorization_requirement": {
          "const": "separate_reference"
        }
      },
      "required": [
        "decision",
        "authorization_requirement"
      ]
    },
    "operationAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "reference",
        "operation_ids"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^AUTH-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Stable exact reference to separately recorded approval or evidence; a placeholder is not proof of approval."
        },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^OP-[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "status"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/actor"
        },
        "recommendation": {
          "enum": [
            "accept",
            "accept_with_conditions",
            "changes_required"
          ]
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewer",
              "recommendation",
              "evidence_reference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": {
                "const": "accept_with_conditions"
              }
            },
            "required": [
              "recommendation"
            ]
          },
          "then": {
            "required": [
              "conditions"
            ]
          }
        }
      ]
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/independentReviewer"
        },
        "evidence_reference": {
          "$ref": "#/$defs/repositoryPath",
          "description": "Repository-local review or evidence reference."
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "rejected"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewer",
              "evidence_reference",
              "reviewed_at"
            ]
          }
        }
      ]
    },
    "finalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_issued",
            "accepted",
            "accepted_with_conditions",
            "rejected"
          ]
        },
        "owner": {
          "allOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "not": {
                "properties": {
                  "role": {
                    "const": "ide_agent"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "accepted_with_conditions",
                  "rejected"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "owner",
              "recorded_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted_with_conditions"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "conditions"
            ]
          }
        }
      ]
    }
  }
}
